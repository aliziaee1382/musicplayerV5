<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <service
            android:name=".service.MediaPlaybackService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".widget.MusicWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.widget.ACTION_TOGGLE_PLAY" />
                <action android:name="com.example.widget.ACTION_PREV" />
                <action android:name="com.example.widget.ACTION_NEXT" />
                <action android:name="com.example.widget.ACTION_FAVORITE" />
                <action android:name="com.example.widget.ACTION_SHUFFLE" />
                <action android:name="com.example.widget.ACTION_REPEAT" />
            </intent-filter>
        </receiver>

        <!-- 1. Compact Widget (2x1) -->
        <receiver
            android:name=".widget.CompactMusicWidget"
            android:exported="true"
            android:label="Compact Music Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_compact_info" />
        </receiver>

        <!-- 2. Standard Widget (4x1) -->
        <receiver
            android:name=".widget.StandardMusicWidget"
            android:exported="true"
            android:label="Standard Music Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_standard_info" />
        </receiver>

        <!-- 3. Vinyl Widget (3x3) -->
        <receiver
            android:name=".widget.VinylMusicWidget"
            android:exported="true"
            android:label="Vinyl Music Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_vinyl_info" />
        </receiver>

        <!-- 4. Full Command Center Widget (4x2) -->
        <receiver
            android:name=".widget.FullCenterMusicWidget"
            android:exported="true"
            android:label="Full Center Music Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_full_center_info" />
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
